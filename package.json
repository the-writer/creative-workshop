{
  "name": "cn.com.stdout.creation-workshop",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "productName": "创作工坊",
  "author": "stdout.com.cn",
  "description": "面向小说世界观创作的人名、地名、官职与绰号生成工具",
  "main": "release/electron/main.cjs",
  "scripts": {
    "start": "pnpm run build && electron .",
    "dev:renderer": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:extension": "pnpm --dir vscode-extension run package",
    "install:extension": "code --install-extension \"vscode-extension/type-stats-v$(node -p \"require('./vscode-extension/package.json').version\").vsix\" --force",
    "build": "pnpm run typecheck && vite build && tsc -p tsconfig.electron.json && pnpm run build:extension",
    "dist:mac": "sh scripts/dist-mac.sh",
    "install:mac": "sh scripts/install-mac.sh",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run && pnpm run build:electron && node --test tests/storage.test.mjs",
    "format": "prettier --write \"{src,electron,tests,scripts}/**/*.{ts,tsx,cts,cjs,mjs,json,css,md}\" \"docs/**/*.md\" \"package.json\" \"*.config.js\"",
    "format:check": "prettier --check \"{src,electron,tests,scripts}/**/*.{ts,tsx,cts,cjs,mjs,json,css,md}\" \"docs/**/*.md\" \"package.json\" \"*.config.js\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "asarmor": "^3.0.2",
    "autoprefixer": "^10.4.22",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  },
  "creationWorkshop": {
    "window": {
      "width": 800,
      "height": 600,
      "minWidth": 320,
      "minHeight": 240,
      "maxWidth": 1024,
      "maxHeight": 768,
      "titleBarStyle": "hiddenInset",
      "alwaysOnTop": false,
      "alwaysOnTopLevel": "floating"
    },
    "project": {
      "dataDirName": ".workshop",
      "registryFileName": "projects.json",
      "legacyDataFileName": "workshop.json",
      "maxRecentProjects": 10
    },
    "tray": {
      "iconFile": "src/assets/imgs/trayTemplate.png"
    }
  },
  "build": {
    "appId": "cn.com.stdout.creation-workshop",
    "productName": "创作工坊",
    "protocols": [
      {
        "name": "创作工坊项目链接",
        "schemes": [
          "workshop"
        ]
      }
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "release/renderer/**/*",
      "release/electron/**/*",
      "src/assets/imgs/trayTemplate*.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSHighResolutionCapable": true,
        "LSUIElement": true
      },
      "target": [
        {
          "target": "pkg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "src/assets/imgs/app-icon.icns"
    },
    "pkg": {
      "scripts": "../scripts/pkg-scripts",
      "installLocation": "/Applications",
      "allowAnywhere": false,
      "allowCurrentUserHome": false,
      "allowRootDirectory": true,
      "isRelocatable": false,
      "artifactName": "creation-workshop-v${version}-${arch}.${ext}"
    },
    "artifactName": "creation-workshop-v${version}-${arch}.${ext}"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
