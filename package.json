{
  "name": "cn.com.stdout.creation-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "productName": "创作工坊",
  "author": "stdout.com.cn",
  "description": "面向小说世界观创作的人名、地名、官职与绰号生成工具",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "start": "pnpm run build && electron .",
    "dev:renderer": "vite",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "pnpm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "dist:mac": "sh scripts/clean-dist.sh && pnpm run build && electron-builder --mac dmg zip --arm64",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "vitest run && pnpm run build:electron && node --test tests/storage.test.mjs",
    "format": "prettier --write \"{src,electron,tests,scripts}/**/*.{ts,tsx,cts,cjs,mjs,json,css,md}\" \"docs/**/*.md\" \"package.json\" \"*.config.js\"",
    "format:check": "prettier --check \"{src,electron,tests,scripts}/**/*.{ts,tsx,cts,cjs,mjs,json,css,md}\" \"docs/**/*.md\" \"package.json\" \"*.config.js\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "asarmor": "^3.0.2",
    "autoprefixer": "^10.4.22",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.1.5"
  },
  "creationWorkshop": {
    "window": {
      "width": 640,
      "height": 480,
      "titleBarStyle": "hiddenInset"
    },
    "storage": {
      "fileName": "workshop.json"
    }
  },
  "build": {
    "appId": "cn.com.stdout.creation-workshop",
    "productName": "创作工坊",
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "assets/imgs/app-icon.icns"
    },
    "artifactName": "creation-workshop-v${version}-${arch}.${ext}"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
